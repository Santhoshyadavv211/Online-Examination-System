import java.util.*;

class OnlineExam {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String[] questions = {
            "Java is a programming language? 1.Yes 2.No",
            "Which is a loop? 1.If 2.For 3.Switch"
        };

        int[] answers = {1, 2};
        int score = 0;

        for (int i = 0; i < questions.length; i++) {
            System.out.println(questions[i]);
            int choice = sc.nextInt();

            if (choice == answers[i])
                score++;
        }

        System.out.println("Your Score: " + score
                + "/" + questions.length);
    }
}